{
  "manifest_version": 3,
  "name": "MoirAI Study Reminder",
  "version": "2.1",
  "description": "Shows the participant's assigned reminder immediately after a study-time tab or window switch.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://moirai.telab.ir/*",
      "https://moirai-fastapi.chbkn.dev/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
