# TEMPLATE ONLY — this file is TRACKED BY GIT. Never put a real key here.
#
# Real values belong in Backend/app/.env (gitignored, and the file the app
# actually loads) or in the hosting panel's env-var section.

# Off in production. While off, SECRET_KEY and ADMIN_EXPORT_KEY have no
# default and the app refuses to start without them.
DEBUG_MODE=False

# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_EXPORT_KEY=

# ── LLM provider ────────────────────────────────────────────────────────────
# 'avalai' (default) routes through the OpenAI-compatible gateway used for
# access from Iran. 'openai' talks to OpenAI directly.
#
# The key and the endpoint are chosen together: with LLM_PROVIDER=openai the
# base URL is pinned to api.openai.com and OPENAI_API_KEY is used, so a
# leftover gateway URL in this file cannot silently redirect traffic.
LLM_PROVIDER=avalai

# Used when LLM_PROVIDER=avalai
AVALAI_API_KEY=
OPENAI_BASE_URL=https://api.avalai.ir/v1

# Used when LLM_PROVIDER=openai OR IMAGE_PROVIDER=openai (must start with sk-)
OPENAI_API_KEY=

CHAT_MODEL=gpt-5-mini
PROMPT_MODEL=gpt-4o-mini
# gpt-image-2 returns base64 inline through AvalAI; gpt-image-1 returns a URL
# on a host unreachable from Iran, so the image generates and is then lost.
IMAGE_MODEL=gpt-image-2

# Where runtime data is written. Must match a Chabokan permanent path
# (مسیرهای دائمی), or every redeploy deletes the database and the generated
# reminder images.
DATA_DIR=/app/data
# Assert that DATA_DIR really is on persistent storage — the app cannot
# detect this itself. Only set it once the permanent path exists.
DATA_PERSISTENT=true

# Participant database. Either SQLite on the persistent disk (four slashes =
# absolute path) or, preferred for a live study, a managed Postgres:
DATABASE_URL=sqlite:////app/data/app.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/moirai

# Leave empty when the Flutter build is served by this same server (default).
# Only needed if the frontend is hosted on a different domain.
CORS_ORIGINS=

ACCESS_TOKEN_EXPIRE_MINUTES=120

# Legacy compatibility setting. Study assignment is now between-subjects:
# `study_group=control` always receives neutral assets and `study_group=eft`
# always receives personalized assets. The extension never randomises arms.
NEUTRAL_RATIO=0.0
